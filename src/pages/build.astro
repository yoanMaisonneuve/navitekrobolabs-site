---
/**
 * Imprimer N0.1 (25.11.2026 ; la page de mai, sur le bras SO-ARM100, est dans archive/v0.5-2026-05-08/). Les faits viennent de la page
 * publiée de N0.1 (ymiaconseil.com/navitek/ : la liste d'achats, les fichiers, ce qui reste à faire) ; les vues sont au rendu du studio
 * (navitek-sim/vues_studio_n01.py). Honnête d'abord : N0.1 n'est pas encore imprimé.
 */
import Base from '../layouts/Base.astro';
import '../styles/pages.css';

const N01 = 'https://ymiaconseil.com/navitek/';
const achats = [
	['17 servos SG90', "Les dix-sept articulations, 9 g chacun. Un ou deux de rechange : le premier sert au gabarit d'essai."],
	['1 Raspberry Pi Pico 2 W', 'Il pilote les servos, une broche chacun ; le Wi-Fi servira à le commander du téléphone.'],
	['4 piles AA NiMH et un boîtier 2 × 2', "4,8 V, la tension des servos, sans régulateur. Des NiMH seulement, jamais des alcalines."],
	['Le petit matériel', "Une diode Schottky 1N5817, un condensateur de 1000 µF, une plaque à trous, six rallonges de servo de 15 cm, du fil."],
	['Des vis M2 autotaraudeuses', 'Environ 88, surtout de 6 mm (le compte exact sortira de la CAO).'],
	['Du PLA, 314 g', "Environ 236 g d'orange et 78 g de gris, en six plateaux."],
];
const fichiers = [
	{ nom: 'Les pièces', fmt: 'STL', poids: '0,2 Mo', href: N01 + 'n01/fichiers/navitek-n01-stl.zip' },
	{ nom: 'Les six plateaux', fmt: '3MF', poids: '0,4 Mo', href: N01 + 'n01/fichiers/navitek-n01-plateaux-3mf.zip' },
	{ nom: 'La CAO', fmt: 'STEP', poids: '0,6 Mo', href: N01 + 'n01/fichiers/navitek-n01-step.zip' },
];
---

<Base
	title="Imprimer N0.1 — Navitek Robolabs"
	description="N0.1, l'humanoïde de Navitek à imprimer : 37 cm, dix-sept servos SG90, un Raspberry Pi Pico, 314 g de PLA. Les pièces, les plateaux, la CAO et la liste d'achats, sous licences ouvertes ; et ce qui reste à faire avant de l'imprimer."
	current="build"
	image="/imprimer/n01-trois-quarts.jpg"
>
	<header class="p-tete">
		<p class="p-sur">Imprimer</p>
		<h1 class="p-titre">N0.1, l'humanoïde qu'on imprime</h1>
		<p class="p-chapeau">
			Tout est publié&nbsp;: les pièces, les plateaux, la CAO, la liste d'achats. Mais nous ne l'avons pas encore imprimé. Voici ce qui
			existe, et ce qui reste à faire avant.
		</p>
	</header>

	<figure class="p-image p-large">
		<img src="/imprimer/n01-vues-studio.jpg" alt="N0.1 debout, de face, de côté et de dos, au studio." width="1800" height="780" />
		<figcaption>N0.1 dans sa pose de départ, de face, de côté et de dos. Le modèle de la simulation, celui qu'on imprimera.</figcaption>
	</figure>

	<section class="p-chiffres" aria-label="N0.1 en bref">
		<div><b>37,5 cm</b><span>debout, des semelles au haut de la tête</span></div>
		<div><b>654 g</b><span>la masse du modèle simulé, pièce par pièce</span></div>
		<div><b>17</b><span>servos SG90 : cinq par jambe, trois par bras, un au cou</span></div>
		<div><b>6</b><span>plateaux d'impression, deux couleurs</span></div>
		<div><b>314 g</b><span>de PLA</span></div>
		<div><b>1</b><span>Raspberry Pi Pico 2 W, le seul cerveau à bord</span></div>
	</section>

	<section class="p-section">
		<p class="p-code">À acheter</p>
		<h2>La liste</h2>
		<ul class="p-liste">
			{
				achats.map(([a, b]) => (
					<li>
						<b>{a}</b>
						<span>{b}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="p-section">
		<p class="p-code">Les fichiers</p>
		<h2>Tout, sous licences ouvertes</h2>
		<p>Les pièces et les plans sous CC BY 4.0, le code sous MIT. Imprimez, modifiez, partagez&nbsp;; citez Navitek Robolabs.</p>
		<div class="p-boutons">
			{
				fichiers.map((f) => (
					<a class="p-bouton" href={f.href}>
						{f.nom} <small>{f.fmt} · {f.poids}</small>
					</a>
				))
			}
			<a class="p-bouton second" href="https://ymiaconseil.com/navitek/telechargements/">Le modèle de marche et le robot pour MuJoCo</a>
		</div>
		<p class="p-note">
			Le guide complet, pièce par pièce, est sur <a href={N01}>la page de N0.1</a>&nbsp;: les plateaux dans l'ordre, les pieds, le
			boîtier des piles, le montage, le câblage et le plan des broches du Pico.
		</p>
	</section>

	<section class="p-section">
		<p class="p-code">Avant d'imprimer</p>
		<h2>Ce qui reste à faire</h2>
		<ol class="p-etapes">
			<li>
				<b>Mesurer un vrai SG90 sur le gabarit.</b> La première mesure, avant tout le reste&nbsp;: la simulation suppose ses couples, il
				faut les vérifier.
			</li>
			<li>
				<b>Une marche qui ne lit que ce que N0.1 mesurera.</b> Celle de la simulation lit des mesures que le vrai robot n'aura pas (le
				SG90 ne renvoie pas sa position)&nbsp;; privée d'elles, elle tombe. Elle s'apprendra en imitant la marche qui voit tout, avec
				une centrale inertielle de quelques dollars.
			</li>
			<li>
				<b>Le programme du Pico et le schéma électrique.</b> Dix-sept servos, le dix-septième par une machine PIO&nbsp;; ceux de N0, la
				version précédente, servent de base.
			</li>
		</ol>
		<p class="p-note">
			Vous l'imprimez avant nous&nbsp;? Une question, une pièce qui ne va pas, une photo&nbsp;: <span class="courriel">yoan@ymiaconseil.com</span>
		</p>
	</section>
</Base>

<style>
	.courriel {
		font-family: var(--mono);
		font-size: 0.88em;
		color: var(--c-ink);
		user-select: all;
	}
</style>
