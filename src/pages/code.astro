---
/**
 * Le code et les données (25.11.2026 ; la page de mai, qui pointait vers un dépôt privé et des projets sans rapport, est dans
 * archive/v0.5-2026-05-08/). Ce qui est ouvert, où le prendre, et comment le travail est fait.
 */
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import labo from '../data/labo.json';

const YM = 'https://ymiaconseil.com/navitek/';
const portes = [
	{ code: 'Le modèle de marche', titre: 'Les poids, le réseau en ONNX, le robot pour MuJoCo', texte: "Le modèle le plus récent et ses données : de quoi faire marcher N0.1 dans votre simulation, et rejouer nos 90 départs du banc.", href: YM + 'telechargements/' },
	{ code: 'Les pièces', titre: 'STL, 3MF, STEP', texte: "Tout ce qu'il faut pour l'imprimer, et la CAO pour le modifier.", href: '/build' },
	{ code: 'Les cahiers', titre: `${labo.cahiers} cahiers de recherche`, texte: 'Chaque essai, sa question, ses prédictions écrites avant, son verdict après, ses mesures.', href: YM + 'recherche/' },
	{ code: 'La méthode', titre: "Comment on entraîne un coureur", texte: "Le tournoi, le juge, combien de pas il faut pour juger une marche, et comment aller plus vite sans rien dépenser.", href: YM + 'entrainement/' },
	{ code: 'Les tests', titre: 'Les exercices et le classement', texte: 'Tous les exercices essayés, et comment le bénéfice de chacun est noté.', href: YM + 'tests/' },
	{ code: 'Ce site', titre: 'navitekrobolabs-site', texte: "Astro, three.js, publié par GitHub Pages ; le rendu 3D de l'accueil compris. Sous licence MIT.", href: 'https://github.com/yoanMaisonneuve/navitekrobolabs-site' },
];
const pile = [
	['MuJoCo', 'La physique : les contacts, les frottements, et les couples réels des SG90 (0,18 N·m), pris à leur fiche technique.'],
	['MuJoCo Warp', '4 096 robots simulés à la fois sur une carte graphique de bureau (une RTX 3060 Ti) : quatre minutes pour une chasse.'],
	['PyTorch, PPO', "L'apprentissage par renforcement, avec une marche de référence tirée d'une photo d'un pas humain, que le robot imite."],
	['Le banc', 'Trente robots, dix secondes, à trois vitesses : la vitesse tenue par ceux qui restent debout. Le même juge pour toutes les marches.'],
	['Le studio', 'Le rendu des films et des figures : le même décor pour tout, la caméra qui suit sans trembler.'],
];
---

<Base
	title="Le code et les données — Navitek Robolabs"
	description="Ce que Navitek publie pour refaire ses résultats : le modèle de marche de N0.1, le robot pour MuJoCo, les pièces, les cahiers de recherche, la méthode ; et la pile, de MuJoCo Warp à PPO."
	current="code"
>
	<header class="p-tete">
		<p class="p-sur">Code et données</p>
		<h1 class="p-titre">Pour refaire nos résultats</h1>
		<p class="p-chapeau">
			Le modèle de marche, le robot pour MuJoCo, les pièces, les cahiers et la méthode&nbsp;: publiés en paquets versionnés, sous
			licences ouvertes, comme un article de recherche.
		</p>
	</header>

	<section class="p-section p-large">
		<div class="p-grille">
			{
				portes.map((p) => (
					<a class="p-carte" href={p.href}>
						<span class="p-code">{p.code}</span>
						<b>{p.titre}</b>
						<span>{p.texte}</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="p-section">
		<p class="p-code">La pile</p>
		<h2>Comment le travail est fait</h2>
		<ul class="p-liste">
			{
				pile.map(([a, b]) => (
					<li>
						<b>{a}</b>
						<span>{b}</span>
					</li>
				))
			}
		</ul>
		<p class="p-note">
			Nos outils vivent dans un dépôt de travail privé, qui contient aussi nos autres projets. Tout ce qui sert à refaire un résultat de
			N0.1 est publié dans les paquets ci-dessus&nbsp;; s'il vous manque quelque chose, écrivez-nous.
		</p>
	</section>
</Base>
