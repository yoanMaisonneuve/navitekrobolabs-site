---
/**
 * L'accueil de navitekrobolabs.com (refait le 25.11.2026 ; Yoan, 23:04 : « This website is yours… make it great »). N0.1 rejoué en 3D,
 * les chiffres vivants (src/data/labo.json, écrit par navitek-recherche/exporter_labo_navitek.py, jamais à la main), la course vers
 * 60 cm/s, la méthode, ce qui tourne sur la tour. Le manifeste de mai est sur /pourquoi, tel quel.
 */
import Base from '../layouts/Base.astro';
import Replay3D from '../components/Replay3D.astro';
import CourbeRecords from '../components/CourbeRecords.astro';
import labo from '../data/labo.json';
import chronologie from '../../public/n01/chronologie.json';

const nf = (x: number, d = 0) => {
	const [e, f] = x.toFixed(d).split('.');
	return e.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + (f ? ',' + f : '');
};
const MOIS = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
const jour = (iso: string) => {
	const [, m, j] = iso.split('-').map(Number);
	return `${j === 1 ? '1er' : j} ${MOIS[m - 1]}`;
};
const etiquette = (k: string, n: number) =>
	({ confirmée: n > 1 ? 'confirmées' : 'confirmée', réfutée: n > 1 ? 'réfutées' : 'réfutée', partielle: 'en partie' } as Record<string, string>)[k] ?? k;
const r = labo.record;
const o = labo.objectif;
const v = labo.verdicts as Record<string, number>;

const essais = [
	{ nom: 'record', titre: 'Le record', detail: `${nf(r.vitesse, 1)} cm/s · ${nf(r.kmh_humain, 1)} km/h à l'échelle humaine` },
	{ nom: 'penche', titre: 'Penché comme un avion', detail: '33,3 cm/s · le tronc incliné vers l’avant' },
	{ nom: 'marche', titre: 'La marche', detail: '10 cm/s · la jambe de devant posée tendue' },
];
---

<Base
	title="Navitek Robolabs — un robot qu'on imprime apprend à marcher"
	description="N0.1, un humanoïde de 37 cm à dix-sept servos SG90, apprend à marcher en simulation, sur une seule carte graphique. Un humain et une IA, une recherche ouverte : chaque prédiction écrite avant l'essai, chaque verdict publié."
	current="home"
	autre="/en/"
	pageClass="accueil"
>
	<header class="a-tete">
		<p class="a-sur">Navitek Robolabs · Québec · recherche ouverte</p>
		<h1 class="a-titre">Un robot qu'on <em>imprime</em> apprend à marcher.</h1>
		<p class="a-chapeau">
			N0.1 mesure 37&nbsp;cm et bouge avec dix-sept servos de modélisme à quelques dollars. Il apprend en simulation, sur une seule
			carte graphique. Un humain et une IA écrivent chaque prédiction avant l'essai et publient chaque verdict, les ratés aussi.
		</p>
	</header>

	<Replay3D essais={essais} />
	<p class="a-sous-scene">
		Chaque pas est celui du robot en simulation (MuJoCo, aux couples réels des SG90)&nbsp;: le robot du milieu de trente départs, rejoué
		tel quel. Rien n'est encore imprimé.
	</p>

	<section class="a-chiffres" aria-label="Les chiffres">
		<div><b>{nf(r.vitesse, 1)}<small> cm/s</small></b><span>le record de vitesse, {r.debout} robots debout sur 30 ({jour(r.date)})</span></div>
		<div><b>{nf(o.vitesse)}<small> cm/s</small></b><span>l'objectif&nbsp;: une marche humaine normale, à cette taille</span></div>
		<div><b>{labo.cahiers}</b><span>cahiers de recherche depuis le {jour(labo.debut)}</span></div>
		<div><b>{nf(labo.hypotheses)}</b><span>prédictions écrites avant l'essai, dont {nf(v['réfutée'] ?? 0)} réfutées et publiées</span></div>
		<div><b>{nf(labo.pas_simulation / 1e9, 1)}<small> G</small></b><span>pas de simulation, {nf(labo.apprentissages)} apprentissages</span></div>
		<div><b>{labo.erreurs}</b><span>erreurs notées, chacune avec sa règle</span></div>
	</section>

	<section class="a-section">
		<p class="a-code">La course</p>
		<h2>Vers 60&nbsp;cm/s</h2>
		<p>
			Le but, posé le 19 novembre&nbsp;: deux fois sa taille par seconde. Chaque point est un record, mesuré au même banc (trente
			robots, dix secondes, la vitesse tenue par ceux qui restent debout). Rapporté à sa taille par le nombre de Froude, le record de
			{nf(r.vitesse, 1)}&nbsp;cm/s vaut {nf(r.kmh_humain, 1)}&nbsp;km/h pour un humain de mêmes proportions&nbsp;; l'objectif,
			{nf(o.kmh_humain, 1)}&nbsp;km/h&nbsp;: une marche, pas encore une course.
		</p>
		<CourbeRecords langue="fr" />
	</section>

	<section class="a-section a-avant-scene">
		<p class="a-code">Regardez-le apprendre</p>
		<h2>Les {chronologie.length} records, rejoués dans l'ordre</h2>
		<p>
			Du {jour(chronologie[0].date)}, {nf(chronologie[0].vitesse, 1)}&nbsp;cm/s, au {jour(chronologie[chronologie.length - 1].date)},
			{nf(chronologie[chronologie.length - 1].vitesse, 1)}&nbsp;cm/s&nbsp;: chaque record de la courbe, au même banc, le robot du milieu de
			son essai. Glissez le curseur, ou laissez-le dérouler&nbsp;: le pas s'allonge, le corps se penche, la course vient.
		</p>
	</section>
	<Replay3D chronologie={chronologie} affiche="/n01/affiche-record.jpg" />

	<section class="a-section">
		<p class="a-code">La méthode</p>
		<h2>Une recherche tenue en public</h2>
		<ol class="a-methode">
			<li>
				<b>Prédire avant.</b> Chaque essai commence par ses hypothèses, chacune avec sa crédence, écrites avant de lancer
				l'apprentissage.
			</li>
			<li>
				<b>Juger après.</b> Le verdict tient en une phrase, avec ses mesures&nbsp;: confirmée, en partie, réfutée. {nf(v['réfutée'] ?? 0)}
				de nos {nf(labo.hypotheses)} prédictions ont été réfutées&nbsp;; elles restent publiées.
			</li>
			<li>
				<b>Tout montrer.</b> Les cahiers, les films, les erreurs, le code et les modèles. Aucun résultat n'est annoncé avant d'avoir
				été vu en film.
			</li>
		</ol>
	</section>

	<section class="a-section">
		<p class="a-code">En ce moment</p>
		<h2>Sur la tour, cette nuit</h2>
		<p>
			La tour, c'est une carte graphique de bureau (une RTX 3060 Ti). Elle apprend la nuit&nbsp;; les verdicts s'écrivent au matin.
			Voici ce qu'elle mesure, avec ce que nous prédisons.
		</p>
		<div class="a-cahiers">
			{
				labo.en_cours.map((c) => (
					<article class="a-cahier">
						<p class="a-cahier-id">
							{c.id} · {jour(c.date)} · {c.n_attente} prédiction{c.n_attente > 1 ? 's' : ''} en attente
						</p>
						<h3>{c.titre}</h3>
						<ul>
							{c.attente.slice(0, 2).map((h) => (
								<li>
									<span class="a-credence" title="crédence : notre probabilité, écrite avant l'essai">
										{h.credence !== null ? nf(h.credence * 100) + ' %' : '?'}
									</span>
									{h.enonce}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</section>

	<section class="a-section">
		<p class="a-code">Les derniers verdicts</p>
		<h2>Ce que la tour a tranché</h2>
		<ul class="a-verdicts">
			{
				labo.derniers.slice(0, 5).map((c) => (
					<li>
						<span class="a-v-id">{c.id}</span>
						<span class="a-v-titre">{c.titre}</span>
						<span class="a-v-puces">
							{Object.entries(c.verdicts).map(([k, n]) => (
								<span class={`puce ${k === 'confirmée' ? 'ok' : k === 'réfutée' ? 'non' : 'part'}`}>
									{n} {etiquette(k, n)}
								</span>
							))}
						</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="a-portes" aria-label="Pour aller plus loin">
		<a class="a-porte" href="/these/">
			<span class="a-code">La thèse</span>
			<b>Apprendre à marcher à un humanoïde imprimé</b>
			<span>La méthode, les résultats, les films, les erreurs&nbsp;: tout le travail, à jour.</span>
		</a>
		<a class="a-porte" href="https://ymiaconseil.com/navitek/reseaux/">
			<span class="a-code">Les films</span>
			<b>Les meilleures courses de N0.1, au studio</b>
			<span>Le record, le penché, la marche.</span>
		</a>
		<a class="a-porte" href="/pourquoi">
			<span class="a-code">Pourquoi</span>
			<b>La robotique, un protocole de paix</b>
			<span>Le manifeste de Navitek&nbsp;: l'intelligence physique, au service des besoins de base.</span>
		</a>
	</section>
</Base>

<style>
	.a-tete {
		padding-top: clamp(1.5rem, 5vw, 3.5rem);
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
	}
	.a-sur,
	.a-code {
		font-family: var(--mono);
		font-size: 0.74rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--c-accent);
		margin: 0 0 0.9rem;
	}
	.a-titre {
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(2.2rem, 6.2vw, 3.6rem);
		line-height: 1.04;
		letter-spacing: -0.02em;
		margin: 0 0 1.1rem;
		text-wrap: balance;
	}
	.a-titre em {
		font-style: italic;
		color: #d9622b;
	}
	.a-chapeau {
		font-family: var(--serif);
		font-size: clamp(1.08rem, 2.4vw, 1.28rem);
		line-height: 1.55;
		color: var(--c-ink);
		opacity: 0.86;
		margin: 0;
		max-width: 38em;
	}
	.a-avant-scene {
		margin-bottom: 1.4rem;
	}
	.a-sous-scene {
		font-size: 0.86rem;
		color: var(--c-muted);
		margin: 0.9rem 0 0;
		text-align: center;
	}
	.a-chiffres {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.4rem 1.2rem;
		margin: clamp(2.5rem, 6vw, 4rem) 0;
	}
	.a-chiffres div {
		border-top: 2px solid var(--c-accent-bright);
		padding-top: 0.7rem;
		min-width: 0;
	}
	.a-chiffres b {
		display: block;
		font-family: var(--serif);
		font-size: clamp(1.7rem, 4.2vw, 2.25rem);
		font-weight: 600;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}
	.a-chiffres small {
		font-size: 0.5em;
		font-weight: 500;
		color: var(--c-muted);
	}
	.a-chiffres span {
		display: block;
		font-size: 0.86rem;
		line-height: 1.45;
		color: var(--c-muted);
		margin-top: 0.3rem;
	}
	.a-section {
		margin: clamp(3rem, 7vw, 4.5rem) 0;
	}
	.a-section h2 {
		font-family: var(--serif);
		font-weight: 600;
		font-size: clamp(1.6rem, 3.6vw, 2.1rem);
		line-height: 1.15;
		margin: 0 0 1rem;
		text-wrap: balance;
	}
	.a-section > p {
		margin: 0 0 1.2rem;
	}
	@media (max-width: 560px) {
			}
	.a-methode {
		margin: 0;
		padding-left: 1.3rem;
		display: grid;
		gap: 0.9rem;
	}
	.a-methode li::marker {
		font-family: var(--serif);
		font-weight: 600;
		color: var(--c-accent);
	}
	.a-cahiers {
		display: grid;
		gap: 1rem;
	}
	.a-cahier {
		border: 1px solid var(--c-card-border);
		background: var(--c-card);
		border-radius: 14px;
		padding: 1.1rem 1.2rem 0.6rem;
		min-width: 0;
	}
	.a-cahier-id {
		font-family: var(--mono);
		font-size: 0.74rem;
		color: var(--c-accent);
		margin: 0 0 0.35rem;
		letter-spacing: 0.04em;
	}
	.a-cahier h3 {
		font-family: var(--serif);
		font-size: 1.12rem;
		font-weight: 600;
		line-height: 1.3;
		margin: 0 0 0.6rem;
	}
	.a-cahier ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.a-cahier li {
		display: grid;
		grid-template-columns: 3.4rem 1fr;
		gap: 0.7rem;
		align-items: baseline;
		font-size: 0.92rem;
		line-height: 1.5;
		padding: 0.55rem 0;
		border-top: 1px solid var(--c-rule);
	}
	.a-credence {
		font-family: var(--mono);
		font-size: 0.78rem;
		font-weight: 500;
		text-align: center;
		padding: 0.15rem 0;
		border-radius: 999px;
		border: 1px solid var(--c-card-border);
		color: var(--c-accent);
		font-variant-numeric: tabular-nums;
	}
	.a-verdicts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.a-verdicts li {
		display: grid;
		grid-template-columns: 4.2rem 1fr;
		gap: 0.3rem 0.9rem;
		padding: 0.8rem 0;
		border-top: 1px solid var(--c-rule);
		font-size: 0.95rem;
		line-height: 1.45;
	}
	.a-v-id {
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--c-accent);
		padding-top: 0.15rem;
	}
	.a-v-puces {
		grid-column: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.puce {
		font-family: var(--mono);
		font-size: 0.72rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--c-rule);
	}
	.puce.ok {
		color: #3f7a4f;
		border-color: rgba(63, 122, 79, 0.35);
	}
	.puce.non {
		color: #b3462b;
		border-color: rgba(179, 70, 43, 0.35);
	}
	.puce.part {
		color: var(--c-accent);
		border-color: var(--c-card-border);
	}
	.a-portes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: clamp(3rem, 7vw, 4.5rem) 0 2rem;
	}
	.a-porte {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.2rem 1.2rem;
		border-radius: 14px;
		border: 1px solid var(--c-card-border);
		background: var(--c-card);
		color: var(--c-ink);
		text-decoration: none;
		min-width: 0;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.a-porte:hover {
		border-color: var(--c-accent-bright);
		transform: translateY(-2px);
	}
	.a-porte .a-code {
		margin: 0;
	}
	.a-porte b {
		font-family: var(--serif);
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.a-porte span:last-child {
		font-size: 0.88rem;
		color: var(--c-muted);
		line-height: 1.45;
	}
	@media (max-width: 720px) {
		.a-chiffres {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.a-portes {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-color-scheme: dark) {
		.a-titre em {
			color: #f07a3e;
		}
		.puce.ok {
			color: #7fc18f;
		}
		.puce.non {
			color: #f08a6e;
		}
	}
</style>
