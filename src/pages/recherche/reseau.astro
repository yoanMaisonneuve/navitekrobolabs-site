---
/**
 * Le rapport « Pourquoi ce réseau » (R-242 ; Yoan, 27.11.2026 22:00 : « publie le rapport de recherche sur l'analyse de la méthode et le
 * choix du modèle, vulgarisé : nombre de couches et nombre de paramètres, hypothèses, plage de test et résultats, puis méthode et
 * conclusions »). Écrit à la main depuis le cahier R-242 (dyad, recherche/journal) ; mis à jour le 28.11 au matin avec B2 (le dégel
 * doux), la partie A (200 M de pas depuis zéro) et l'audit des paies (R-243 § 8) ; à mettre à jour au verdict de B3. La lecture à voix
 * haute : public/recherche/reseau-lecture.mp3 (loops/outils/voix/lecture_haute.py, la voix Sylvie).
 */
import Base from '../../layouts/Base.astro';
import '../../styles/pages.css';
// Les graphiques : navitek-recherche/graphiques_reseau.py (dyad), tirés des données, jamais à la main.
import G from '../../data/reseau-graphiques.json';

const formes = [
	{ nom: '2 × 256', role: 'le nôtre (R-139, 13 novembre)', couches: 2, largeur: '256', params: '93 714' },
	{ nom: '512-256-128', role: 'celui du domaine', couches: 3, largeur: '512, 256, 128', params: '213 138' },
	{ nom: '3 × 256', role: 'plus profond', couches: 3, largeur: '256', params: '159 506' },
	{ nom: '4 × 256', role: 'plus profond', couches: 4, largeur: '256', params: '225 298' },
	{ nom: '6 × 256', role: 'plus profond', couches: 6, largeur: '256', params: '356 882' },
	{ nom: '10 × 256', role: 'beaucoup plus profond', couches: 10, largeur: '256', params: '620 050' },
	{ nom: '512 × 2', role: 'plus large', couches: 2, largeur: '512', params: '318 482' },
	{ nom: '1 024 × 2', role: 'beaucoup plus large', couches: 2, largeur: '1 024', params: '1 161 234' },
];
const hypotheses = [
	{ h: 'H1241', txt: 'Partie de zéro, la forme 2 × 256 apprend à tenir debout en 60 millions de pas.', k: '0,5', v: 'confirmée', note: '9,3 secondes debout à la fin.' },
	{ h: 'H1242', txt: 'Elle apprend aussi à marcher lentement (10 cm/s).', k: '0,3', v: 'réfutée', note: 'Debout sur place : 0,9 cm/s.' },
	{ h: 'H1243', txt: 'La forme du domaine apprend plus vite (au moins 10 % de mieux sur toute la course).', k: '0,35', v: 'réfutée', note: '+5 % seulement, mais elle tient debout deux fois plus tôt.' },
	{ h: 'H1244', txt: 'Faire grandir le réseau sans changer ce qu’il calcule ne change pas la marche (à 1 robot près).', k: '0,8', v: 'réfutée', note: 'Le banc lui-même varie de 4 robots : la marche est la même, dans ce bruit.' },
	{ h: 'H1245', txt: 'Plus large n’aide pas la vitesse, sans la gêner.', k: '0,6', v: 'réfutée', note: 'Les réseaux plus larges se sont effondrés (le pas d’apprentissage).' },
	{ h: 'H1246', txt: 'Plus profond (3, 4, 6 couches) n’aide pas, sans gêner.', k: '0,55', v: 'réfutée', note: 'Effondrés aussi, pour la même raison.' },
	{ h: 'H1247', txt: 'Trop profond (10 couches) coûte.', k: '0,35', v: 'confirmée', note: 'Mais par le pas d’apprentissage, pas par la profondeur elle-même.' },
	{ h: 'H1248', txt: 'Une forme plus grosse va plus vite que la nôtre.', k: '0,25', v: 'réfutée', note: 'Aucune.' },
	{ h: 'H1249', txt: 'Partie de zéro sur 200 millions de pas, une forme apprend à marcher (10 cm/s).', k: '0,35', v: 'réfutée', note: 'Aucune : immobiles, 0,2 à 0,7 cm/s.' },
	{ h: 'H1250', txt: 'Celle du domaine tient debout plus tôt que la nôtre.', k: '0,6', v: 'confirmée', note: 'À 4,4 millions de pas contre 8,8 ; et 4 × 256 à 3,9.' },
	{ h: 'H1257', txt: 'Avec un départ doux, aucune forme agrandie ne s’effondre.', k: '0,55', v: 'réfutée', note: 'Aucune jusqu’à 4 couches et 1 024 de large ; à 6 et 10 couches, les six graines.' },
	{ h: 'H1258', txt: 'Le départ doux ne coûte rien à notre réseau.', k: '0,6', v: 'partielle', note: 'Aucune graine effondrée (une avant) ; la vitesse, −0,9 cm/s en médiane des paires : dans le bruit du banc.' },
	{ h: 'H1259', txt: 'La capacité n’aide toujours pas la vitesse (à 1 cm/s près).', k: '0,5', v: 'réfutée', note: '1 024 × 2 : +2,2 cm/s ; 4 × 256 : +1,9.' },
	{ h: 'H1260', txt: 'Une forme plus grosse va plus vite que la nôtre (au moins +1 cm/s, 5 paires sur 6).', k: '0,2', v: 'confirmée', note: '1 024 × 2 : +2,2 cm/s, 5 paires sur 6. À confirmer sur plus de graines.' },
	{ h: 'H1271 à H1274', txt: 'Sur 12 graines neuves, 1 024 × 2 et 4 × 256 vont plus vite que notre réseau, sans s’effondrer.', k: '—', v: 'en cours', note: 'B3 : 36 essais, aujourd’hui.' },
];
const classe = (v: string) => ({ confirmée: 'ok', réfutée: 'non', 'en cours': 'attente' } as Record<string, string>)[v] ?? 'part';
---

<Base
	title="Pourquoi ce réseau ? — Navitek Robolabs"
	description="Combien de couches et de paramètres faut-il au cerveau d'un petit humanoïde qui apprend à marcher ? Nos hypothèses, la plage testée, les résultats, la méthode et les conclusions, en clair."
	current="recherche"
>
	<header class="p-tete">
		<p class="p-sur">Rapport de recherche · R-242 · 27 novembre 2026 · mis à jour le 28 novembre au matin · en cours</p>
		<h1 class="p-titre">Pourquoi ce réseau&nbsp;? Combien de couches, combien de paramètres</h1>
		<p class="p-chapeau">
			Le cerveau de N0.1 est un réseau de neurones de 2 couches de 256 neurones. Nous l'avions choisi sans étude. Yoan a demandé de le
			justifier, comme un chercheur&nbsp;: voici ce que nous avons testé, ce que nous avons trouvé, et ce qui tourne encore.
		</p>
	</header>

	<div class="lh" role="region" aria-label="Lecture à voix haute">
		<button id="lh-btn" type="button"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path id="lh-ico" d="M4 2l12 7-12 7z" fill="currentColor"></path></svg><span id="lh-lbl">Lecture à voix haute</span></button>
		<select id="lh-vit" aria-label="Vitesse"><option value="1">1 ×</option><option value="1.25">1,25 ×</option><option value="1.5">1,5 ×</option></select>
		<span id="lh-temps">environ 11 min</span>
		<audio id="lh-audio" src="/recherche/reseau-lecture.mp3" preload="none"></audio>
	</div>

	<section class="p-section">
		<p class="p-code">En bref</p>
		<ol class="rr-bref">
			<li><b>Notre réseau n'a jamais été mis à l'épreuve.</b> Il date du 13 novembre, quand nous avons écrit l'apprentissage à la main. Le domaine utilise plutôt 3 couches (512, 256, 128), environ deux fois plus de paramètres, sans l'avoir étudié non plus.</li>
			<li><b>Partis de zéro, les réseaux apprennent à tenir debout, pas à marcher</b>, même en 200 millions de pas. Celui du domaine et un réseau de 4 couches apprennent à tenir debout deux fois plus vite que le nôtre.</li>
			<li><b>Un réseau plus gros ne peut pas reprendre nos réglages tels quels.</b> Agrandi sans rien changer à ce qu'il calcule, il marche comme le nôtre&nbsp;; mais à la première mise à jour de l'apprentissage, il s'effondre. C'est le pas d'apprentissage, réglé pour 2 × 256.</li>
			<li><b>Avec un départ dix fois plus doux, les gros réseaux tiennent, et vont un peu plus vite</b>&nbsp;: 1 024 × 2 +2,2 cm/s, 4 couches +1,9, sur six paires. À 6 et 10 couches, tout s'effondre encore. On le vérifie aujourd'hui sur 12 graines neuves.</li>
			<li><b>Ce qui retient vraiment la vitesse, c'est la récompense</b>&nbsp;: elle paie surtout la posture, la vitesse ne compte que pour 8 à 10&nbsp;%, et une chute coûte cher. Debout et immobile, un robot touche déjà presque tout.</li>
			<li><b>Notre banc d'essai n'est pas parfaitement répétable</b>&nbsp;: le même robot, jugé dix fois, garde de 19 à 26 robots debout sur 30. Un écart sur une seule graine ne prouve rien.</li>
		</ol>
	</section>

	<section class="p-section">
		<p class="p-code">Le réseau, en clair</p>
		<p>
			Cinquante fois par seconde, le réseau lit 90 mesures du corps de N0.1 (l'inclinaison, la vitesse, les angles des articulations, la
			commande de vitesse) et décide la position de ses 17 servomoteurs, plus le rythme de son horloge interne&nbsp;: 18 sorties. Chaque
			<b>neurone</b> fait une somme pondérée de ce qu'il reçoit, puis la plie (une courbe appelée ELU). Une <b>couche</b> en aligne
			plusieurs&nbsp;; les couches s'enchaînent. Un <b>paramètre</b> est un des poids de ces sommes&nbsp;: apprendre, c'est régler ces
			nombres. Le nôtre en a 93 714. Pendant l'apprentissage, un second réseau de même forme, le critique, estime si une situation est
			bonne&nbsp;; il ne sert plus ensuite.
		</p>
		<figure class="rr-fig">
			<Fragment set:html={G.reseau} />
			<figcaption>
				Dessin réduit&nbsp;: quelques ronds par couche. Les 90 mesures&nbsp;: l'inclinaison, les vitesses et la hauteur du tronc, les angles et
				les vitesses des 17 articulations, les consignes en cours, la décision précédente, la direction, la commande de vitesse, l'horloge
				interne et la phase de la marche de référence. Les 18 sorties&nbsp;: la position visée de chaque servo, et le rythme de l'horloge
				qui cadence le pas.
			</figcaption>
		</figure>
		<p>
			Plus de couches permettent des calculs plus composés&nbsp;; plus de neurones par couche, plus de nuances à chaque étage. Mais un
			réseau plus gros est aussi plus lent à régler, et il peut se dérégler plus vite. La question&nbsp;: <b>où est le bon équilibre pour
			apprendre à marcher à un petit humanoïde&nbsp;?</b>
		</p>
		<p class="p-note">
			Corrigé le 27 novembre à 22 h 26&nbsp;: la première version de ce rapport disait 91 mesures, 17 sorties et 93 713 paramètres, comptés
			à la main. Recomptés sur le code et vérifiés contre les vrais réseaux&nbsp;: 90 mesures, 18 sorties, 93 714 paramètres. Les autres
			formes étaient justes.
		</p>
	</section>

	<section class="p-section">
		<p class="p-code">D'où vient notre choix, et ce que fait le domaine</p>
		<div class="rr-tab">
			<table>
				<thead><tr><th>Qui</th><th>Le réseau</th><th>Étudié&nbsp;?</th></tr></thead>
				<tbody>
					<tr><td>Navitek, N0.1<span class="rr-note">13 novembre 2026 (R-139)</span></td><td class="rr-n">2 × 256</td><td>non</td></tr>
					<tr><td>legged_gym<span class="rr-note">ETH Zurich</span></td><td class="rr-n"><span class="rr-f">512-256-128</span></td><td>non</td></tr>
					<tr><td>Isaac Lab<span class="rr-note">ANYmal, G1 ; terrain plat : 128 × 3</span></td><td class="rr-n"><span class="rr-f">512-256-128</span></td><td>non</td></tr>
					<tr><td>Humanoid-Gym<span class="rr-note">le critique : 768-256-128</span></td><td class="rr-n"><span class="rr-f">512-256-128</span></td><td>non</td></tr>
					<tr><td>mjlab<span class="rr-note">G1</span></td><td class="rr-n"><span class="rr-f">512-256-128</span></td><td>non</td></tr>
					<tr><td>La grande étude de PPO<span class="rr-note">Andrychowicz et al., 2021 : 5 tâches de laboratoire, pas un robot</span></td><td class="rr-n">64 × 2</td><td>en partie</td></tr>
				</tbody>
			</table>
		</div>
		<p class="p-note">Notre revue de la littérature (R-232, 23 novembre) : personne n'a publié pourquoi ces formes. C'est ce que nous cherchons ici.</p>
	</section>

	<section class="p-section">
		<p class="p-code">Les hypothèses, écrites avant les essais</p>
		<p>Chaque prédiction est écrite avant l'essai, avec la confiance qu'on lui donne (la crédence, de 0 à 1), puis tranchée après.</p>
		<ul class="rr-hyp">
			{hypotheses.map((x) => (
				<li>
					<p class="rr-hyp-tete">
						<span class="rr-n"><b>{x.h}</b></span>
						{x.k !== '—' && <span class="rr-k">crédence {x.k}</span>}
						<span class={'puce ' + classe(x.v)}>{x.v}</span>
					</p>
					<p>{x.txt}</p>
					<p class="rr-note">{x.note}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="p-section">
		<p class="p-code">La plage de test</p>
		<p>De 2 à 10 couches, de 93 714 à 1 161 234 paramètres dans le réseau de l'action (douze fois plus), en faisant varier une chose à la fois&nbsp;: la profondeur à largeur fixe, la largeur à profondeur fixe, et la forme du domaine.</p>
		<figure class="rr-fig">
			<Fragment set:html={G.parametres} />
			<figcaption>Les paramètres de chaque forme essayée, à la même échelle&nbsp;: le nôtre en orange, celui du domaine en bleu.</figcaption>
		</figure>
		<div class="rr-tab">
			<table>
				<thead><tr><th>Forme</th><th>Couches</th><th>Paramètres</th></tr></thead>
				<tbody>
					{formes.map((x) => (
						<tr><td class="rr-n"><span class="rr-f">{x.nom}</span><span class="rr-note">{x.role}</span></td><td class="rr-n">{x.couches}</td><td class="rr-n">{x.params}</td></tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<section class="p-section">
		<p class="p-code">Les résultats</p>
		<h2 class="rr-h">1. Partis de zéro, 60 millions de pas</h2>
		<p>Sans robot de départ, avec notre récompense&nbsp;: les deux réseaux apprennent à rester debout, puis s'arrêtent là. Commandés à 10, 20 ou 28 cm/s, ils restent sur place.</p>
		<p><b>Notre mesure de la vitesse d'apprentissage</b>, la règle du 80/20 de Yoan&nbsp;: le nombre de pas d'apprentissage qu'il faut pour tenir <b>8 secondes debout sur 10</b>. Tout se joue dans les 20 premiers millions de pas&nbsp;; c'est là que nous regardons.</p>
		<figure class="rr-fig">
			<Fragment set:html={G.pilotes} />
			<figcaption>
				Les 20 premiers millions de pas, une graine chacun. Le réseau du domaine (en bleu) tient 8 secondes sur 10 deux fois plus tôt que le
				nôtre (en orange)&nbsp;; ensuite, jusqu'à 60 millions, les deux plafonnent vers 9,3 et 9,5 secondes, sans apprendre à marcher.
			</figcaption>
		</figure>
		<div class="rr-tab">
			<table>
				<thead><tr><th>Réseau</th><th>8 s debout à</th><th>Banc à 10 cm/s</th></tr></thead>
				<tbody>
					<tr><td class="rr-n"><span class="rr-f">2 × 256</span></td><td class="rr-n">9,3 millions de pas<span class="rr-note">3 s à 5,9 ; 9,3 s à la fin</span></td><td>30 debout, 0,9 cm/s</td></tr>
					<tr><td class="rr-n"><span class="rr-f">512-256-128</span></td><td class="rr-n">4,4 millions de pas<span class="rr-note">3 s à 3,9 ; 9,5 s à la fin</span></td><td>16 debout, 0,35 cm/s</td></tr>
				</tbody>
			</table>
		</div>
		<p class="p-note">Une graine chacun. Le réseau du domaine apprend l'équilibre deux fois plus vite ; il lui faut 20 minutes au lieu de 15 pour le même nombre de pas.</p>

		<h2 class="rr-h">2. Faire grandir notre réseau sans rien changer</h2>
		<p>
			Pour comparer des tailles dans nos vrais essais de vitesse, on fait grandir notre robot de départ&nbsp;: en largeur, chaque neurone
			est recopié et ses poids de sortie partagés&nbsp;; en profondeur, on ajoute des couches qui laissent passer le signal tel quel. Vérifié
			sur 4 096 situations tirées au hasard&nbsp;: l'écart est de 0,000003 en profondeur (la précision du calcul) et de 0,4 % en largeur
			(un petit bruit voulu, pour que les copies apprennent chacune leur part). Au banc, les sept réseaux marchent tous à 29,2 à 29,8 cm/s.
		</p>
		<p><b>Une découverte au passage&nbsp;:</b> le même robot, jugé trois fois de suite, garde 19, puis 23, puis 21 robots debout sur 30. La carte graphique n'additionne pas toujours dans le même ordre, et une chute amplifie les plus petits écarts.</p>
		<figure class="rr-fig">
			<Fragment set:html={G.bruit} />
			<figcaption>
				Le même robot, jugé dix fois&nbsp;: notre réseau trois fois (en orange) et ses six copies agrandies, qui calculent la même chose à
				0,4&nbsp;% près au plus (en gris). De 19 à 26 robots debout sur 30&nbsp;: c'est le hasard du banc, pas le réseau.
			</figcaption>
		</figure>

		<h2 class="rr-h">3. Les réseaux agrandis, entraînés avec nos réglages</h2>
		<figure class="rr-fig">
			<Fragment set:html={G.effondrees} />
			<figcaption>
				Six graines par forme, le même pas d'apprentissage pour toutes (celui réglé pour 2 × 256)&nbsp;: le nôtre s'effondre une fois,
				512 × 2 quatre fois, toutes les autres six fois sur six.
			</figcaption>
		</figure>
		<div class="rr-tab">
			<table>
				<thead><tr><th>Forme</th><th>Effondrées<br />(sur 6)</th><th>Debout<br />à 28 cm/s</th></tr></thead>
				<tbody>
					<tr><td class="rr-n"><span class="rr-f">2 × 256</span><span class="rr-note">le nôtre</span></td><td class="rr-n">1</td><td class="rr-n">106</td></tr>
					<tr><td class="rr-n"><span class="rr-f">512 × 2</span></td><td class="rr-n">4</td><td class="rr-n">51</td></tr>
					<tr><td class="rr-n"><span class="rr-f">1 024 × 2</span></td><td class="rr-n">6</td><td class="rr-n">0</td></tr>
					<tr><td class="rr-n"><span class="rr-f">3 × 256</span></td><td class="rr-n">6</td><td class="rr-n">0</td></tr>
					<tr><td class="rr-n"><span class="rr-f">4 × 256</span></td><td class="rr-n">6</td><td class="rr-n">0</td></tr>
					<tr><td class="rr-n"><span class="rr-f">6 × 256</span></td><td class="rr-n">6</td><td class="rr-n">0</td></tr>
					<tr><td class="rr-n"><span class="rr-f">10 × 256</span></td><td class="rr-n">6</td><td class="rr-n">0</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Pendant le démarrage, où seul le critique apprend, les sept réseaux font exactement la même chose. Tout casse à la <b>première mise à
			jour de l'action</b>&nbsp;: l'optimiseur (Adam) déplace chaque poids d'à peu près le même petit pas, et dans un réseau plus large ou plus
			profond ces pas s'additionnent. À 10 couches, l'écart entre deux versions de la politique bondit à près de 2 000, contre 0,01
			d'habitude. Ce pas avait été réglé le 15 novembre pour 2 × 256, après une chute du même genre (E90).
		</p>
		<figure class="rr-fig">
			<Fragment set:html={G.degel} />
			<figcaption>
				Une graine (150201), cinq des sept formes. Jusqu'à la fin du gel, les courbes se confondent. À la première mise à jour de l'action,
				toutes plongent&nbsp;: le nôtre se reprend (7,8 secondes à la fin), 512 × 2 aussi à cette graine (il s'effondre à quatre sur six),
				3 × 256 à moitié&nbsp;; les plus gros restent par terre.
			</figcaption>
		</figure>

		<h2 class="rr-h">4. Le départ doux&nbsp;: les gros réseaux tiennent</h2>
		<p>
			On a repris les mêmes six réseaux et le nôtre, avec un premier pas d'apprentissage dix fois plus petit (l'apprentissage le relève
			seul ensuite, s'il le peut). Jusqu'à 4 couches et 1 024 neurones de large, <b>plus aucune graine ne s'effondre</b>. À 6 et 10
			couches, tout tombe encore&nbsp;: même ce petit pas, répété dans huit couches qui s'enchaînent, déplace trop la politique.
		</p>
		<figure class="rr-fig">
			<Fragment set:html={G.effondrees2} />
			<figcaption>Six graines par forme, avant et avec le départ doux. Notre réseau en orange.</figcaption>
		</figure>
		<p>
			Et ceux qui tiennent vont un peu plus vite que le nôtre, au même départ doux&nbsp;: <b>1 024 × 2 de 2,2 cm/s</b> (5 paires sur 6),
			<b>4 × 256 de 1,9 cm/s</b> (4 sur 6), en gardant plus de robots debout. Six paires, c'est peu&nbsp;: cinq sur six au-dessus arrive une
			fois sur neuf par hasard. On le vérifie aujourd'hui sur 12 graines neuves.
		</p>
		<figure class="rr-fig">
			<Fragment set:html={G.doux_vitesse} />
			<figcaption>
				Chaque point&nbsp;: une graine, l'écart de vitesse à notre réseau entraîné avec la même graine, à 28 cm/s commandés. Le trait&nbsp;:
				la médiane. La graine 150203 est en bas partout&nbsp;: c'est notre réseau qui y a été très rapide (32,2 cm/s), pas les autres lents.
			</figcaption>
		</figure>
		<div class="rr-tab">
			<table>
				<thead><tr><th>Forme</th><th>Contre le nôtre<br />à 28 cm/s</th><th>Temps de calcul<br />(15 M de pas)</th></tr></thead>
				<tbody>
					<tr><td class="rr-n"><span class="rr-f">2 × 256</span><span class="rr-note">le nôtre, départ doux</span></td><td class="rr-n">29,6 cm/s</td><td class="rr-n">3,95 min</td></tr>
					<tr><td class="rr-n"><span class="rr-f">512 × 2</span></td><td class="rr-n">+0,06 cm/s<span class="rr-note">3 paires sur 6</span></td><td class="rr-n">4,48 min<span class="rr-note">+13 %</span></td></tr>
					<tr><td class="rr-n"><span class="rr-f">1 024 × 2</span></td><td class="rr-n">+2,2 cm/s<span class="rr-note">5 paires sur 6</span></td><td class="rr-n">6,24 min<span class="rr-note">+58 %</span></td></tr>
					<tr><td class="rr-n"><span class="rr-f">3 × 256</span></td><td class="rr-n">+0,9 cm/s<span class="rr-note">4 paires sur 6</span></td><td class="rr-n">4,17 min<span class="rr-note">+6 %</span></td></tr>
					<tr><td class="rr-n"><span class="rr-f">4 × 256</span></td><td class="rr-n">+1,9 cm/s<span class="rr-note">4 paires sur 6</span></td><td class="rr-n">4,37 min<span class="rr-note">+11 %</span></td></tr>
					<tr><td class="rr-n"><span class="rr-f">6 × 256</span></td><td>effondré<span class="rr-note">6 sur 6</span></td><td class="rr-n">4,71 min</td></tr>
					<tr><td class="rr-n"><span class="rr-f">10 × 256</span></td><td>effondré<span class="rr-note">6 sur 6</span></td><td class="rr-n">5,44 min</td></tr>
				</tbody>
			</table>
		</div>

		<h2 class="rr-h">5. Depuis zéro, 200 millions de pas</h2>
		<p>
			Trois formes, trois fois et demie plus longtemps que les premiers essais&nbsp;: <b>aucune n'apprend à marcher</b>. Toutes tiennent
			debout, et au banc elles restent sur place (0,2 à 0,7 cm/s, commandées à 10, 20 ou 28 cm/s). Pour apprendre l'équilibre, en
			revanche, la profondeur aide&nbsp;: 4 × 256 y arrive le premier, à 3,9 millions de pas, contre 4,4 pour le domaine et 8,8 pour le
			nôtre&nbsp;; et il ne coûte que 8&nbsp;% de calcul de plus (le domaine&nbsp;: 70&nbsp;%).
		</p>
		<figure class="rr-fig">
			<Fragment set:html={G.partie_a} />
			<figcaption>
				Les 20 premiers millions de pas des trois courses de 200 millions, une graine chacune. 4 × 256 (en vert) tient 8 secondes sur 10 le
				premier&nbsp;; ensuite, les trois courbes se confondent vers 9,5 secondes et y restent jusqu'à 200 millions&nbsp;: immobiles.
			</figcaption>
		</figure>
		<div class="rr-tab">
			<table>
				<thead><tr><th>Forme</th><th>8 s debout à<br />(M de pas)</th><th>Temps de calcul<br />(200 M de pas)</th></tr></thead>
				<tbody>
					<tr><td class="rr-n"><span class="rr-f">2 × 256</span><span class="rr-note">le nôtre</span></td><td class="rr-n">8,8</td><td class="rr-n">50 min</td></tr>
					<tr><td class="rr-n"><span class="rr-f">512-256-128</span><span class="rr-note">le domaine</span></td><td class="rr-n">4,4</td><td class="rr-n">85 min</td></tr>
					<tr><td class="rr-n"><span class="rr-f">4 × 256</span></td><td class="rr-n">3,9</td><td class="rr-n">54 min</td></tr>
				</tbody>
			</table>
		</div>

		<h2 class="rr-h">6. Et la récompense&nbsp;?</h2>
		<p>
			Pourquoi l'immobilité&nbsp;? Nous avons fait le compte de ce que la récompense paie à chaque pas (le cahier R-243). Elle paie
			surtout la <b>posture</b>&nbsp;: le tronc penché vers l'avant, le centre de masse bas, l'imitation de la marche de référence, les
			bras. La <b>vitesse</b> vaut au plus 3, et mesurée, 8 à 10&nbsp;% de la récompense. Une <b>chute</b>, elle, coûte environ 1 600&nbsp;:
			tout ce qui restait à gagner. Debout et immobile, un robot touche déjà presque tout&nbsp;; forcer l'allure ne paie que si la chute ne
			devient presque pas plus probable. La prudence de nos robots est le calcul juste de cette récompense.
		</p>
		<figure class="rr-fig">
			<Fragment set:html={G.paies} />
			<figcaption>
				Ce que chaque terme peut payer par pas de 20 millisecondes (pâle), et ce qu'il payait à la fin d'un apprentissage récent (foncé).
				La vitesse en orange&nbsp;: mesurée en payant la vitesse trois fois plus, à la même graine.
			</figcaption>
		</figure>

		<h2 class="rr-h">7. Payer la vitesse trois fois plus ne suffit pas</h2>
		<p>
			Les robots de la nuit repris, avec une seule différence, le poids de la vitesse (9 au lieu de 3)&nbsp;: <b>presque rien ne change</b>,
			un demi-centimètre par seconde à 28 cm/s, rien à 32. Une marche déjà apprise reste la même&nbsp;: le poids de la vitesse n'est pas
			le levier (le cahier R-243).
		</p>

		<h2 class="rr-h">8. Ce qui tourne aujourd'hui</h2>
		<ul class="rr-bref">
			<li><b>L'idée de Yoan</b> (le cahier R-245)&nbsp;: ne plus payer la tenue, mais l'avance&nbsp;; et une première chute qui ne coûte rien, seule la chute qui se répète coûte. Depuis zéro, 20 millions de pas&nbsp;: la marche naît-elle&nbsp;?</li>
			<li><b>B3</b>&nbsp;: notre réseau, 1 024 × 2 et 4 × 256 au départ doux, sur 12 graines neuves (36 essais)&nbsp;: le gain de vitesse tient-il&nbsp;?</li>
		</ul>
	</section>

	<section class="p-section">
		<p class="p-code">La méthode</p>
		<ul class="rr-bref">
			<li><b>Une chose à la fois.</b> Chaque forme ne diffère du témoin que par son réseau&nbsp;: la même recette, le même robot, le même temps d'apprentissage (15 millions de pas, environ 4 minutes sur notre carte graphique).</li>
			<li><b>Les mêmes graines.</b> Chaque forme est comparée au témoin graine par graine (le même hasard de départ), et on lit la médiane des écarts.</li>
			<li><b>Deux façons de comparer.</b> Depuis zéro, ce qui mesure l'apprentissage lui-même (lent)&nbsp;; ou en faisant grandir notre robot de départ, ce qui mesure la capacité dans nos vrais essais (rapide).</li>
			<li><b>Le banc.</b> 30 robots par vitesse commandée (28, 32, 36 cm/s), 10 secondes, dans une physique plus fine que celle de l'apprentissage&nbsp;; un robot compte s'il reste debout (le tronc sous 40°).</li>
			<li><b>Les prédictions d'abord.</b> Écrites avant, avec leur crédence, puis tranchées sans les retoucher&nbsp;; même celles qui tombent juste pour une autre raison sont dites comme telles.</li>
		</ul>
	</section>

	<section class="p-section">
		<p class="p-code">Les conclusions, provisoires</p>
		<ol class="rr-bref">
			<li><b>Notre 2 × 256 marche, mais ce n'est probablement pas le meilleur.</b> Avec un départ doux, 1 024 × 2 et 4 × 256 vont un peu plus vite, sur six paires&nbsp;; à confirmer sur douze graines neuves.</li>
			<li><b>Changer la forme du réseau, c'est aussi changer son pas d'apprentissage.</b> Sans ça, un réseau plus gros s'effondre&nbsp;: nos réglages ne se transportent pas d'une taille à l'autre. C'est connu en apprentissage profond (μP, Yang et Hu, 2021)&nbsp;; nous l'avons mesuré sur notre robot. Au-delà de 4 couches, même le pas le plus doux ne suffit pas&nbsp;: il faudrait un pas qui diminue avec la profondeur.</li>
			<li><b>Pour apprendre l'équilibre, la profondeur aide</b>&nbsp;: 4 × 256 y arrive deux fois plus vite que le nôtre, pour 8 à 11&nbsp;% de calcul de plus.</li>
			<li><b>Le premier frein de la vitesse n'est pas le réseau, c'est la récompense.</b> Elle paie la posture bien plus que la vitesse&nbsp;; partie de zéro, elle mène à l'immobilité, même en 200 millions de pas. Et tripler le poids de la vitesse ne suffit pas&nbsp;: il faut changer ce qu'elle paie. La marche de notre lignée est venue d'un long programme d'apprentissage, pas de cette récompense seule.</li>
			<li><b>Une graine seule ne prouve rien</b>&nbsp;: notre banc varie de plusieurs robots d'un jugement à l'autre&nbsp;; nous comparons toujours sur plusieurs graines appariées.</li>
		</ol>
		<p class="p-note">
			<b>Notre recommandation, provisoire&nbsp;:</b> passer à 4 × 256, avec le départ doux, si les douze graines neuves confirment son gain&nbsp;:
			il apprend l'équilibre deux fois plus vite, coûte à peine plus de calcul, et tient. 1 024 × 2 va aussi vite, mais coûte 58&nbsp;% de
			calcul de plus. Et, avant tout, changer ce que la récompense paie&nbsp;: payer la vitesse trois fois plus ne suffit pas&nbsp;;
			payer l'avance plutôt que la tenue, l'idée de Yoan, est l'essai du jour.
		</p>
	</section>

	<section class="p-section">
		<p class="p-code">Pour aller plus loin</p>
		<ul class="rr-bref">
			<li><a href="https://ymiaconseil.com/navitek/recherche/#R-242">Le cahier R-242</a>, ses hypothèses et ses verdicts, avec tous nos cahiers.</li>
			<li><a href="https://ymiaconseil.com/navitek/recherche/#R-243">Le cahier R-243</a> : la marche de référence à 60 cm/s, la commande qui suit le robot, et le compte de ce que paie la récompense.</li>
			<li><a href="/journal">Le journal</a> : chaque cahier, du plus récent au premier.</li>
			<li><a href="/recherche">La recherche</a> : la thèse, les cahiers, les données et l'état de l'art.</li>
		</ul>
	</section>
</Base>

<script>
	const a = document.getElementById('lh-audio') as HTMLAudioElement;
	const b = document.getElementById('lh-btn')!;
	const l = document.getElementById('lh-lbl')!;
	const i = document.getElementById('lh-ico')!;
	const v = document.getElementById('lh-vit') as HTMLSelectElement;
	const t = document.getElementById('lh-temps')!;
	const m = (s: number) => {
		s = Math.max(0, Math.floor(s || 0));
		return Math.floor(s / 60) + ' min ' + ('0' + (s % 60)).slice(-2) + ' s';
	};
	b.addEventListener('click', () => {
		if (a.paused) {
			a.playbackRate = parseFloat(v.value);
			a.play().catch(() => (l.textContent = 'Touchez encore pour lire'));
		} else a.pause();
	});
	a.addEventListener('play', () => {
		l.textContent = 'Pause';
		i.setAttribute('d', 'M4 2h4v14H4zM10 2h4v14h-4z');
	});
	a.addEventListener('pause', () => {
		l.textContent = 'Reprendre la lecture';
		i.setAttribute('d', 'M4 2l12 7-12 7z');
	});
	a.addEventListener('timeupdate', () => (t.textContent = m(a.currentTime) + ' sur ' + m(a.duration)));
	v.addEventListener('change', () => (a.playbackRate = parseFloat(v.value)));
</script>

